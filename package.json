{
  "name": "@nabilabs/builder",
  "version": "0.2.0",
  "publisher": "nabilabs",
  "displayName": "Nabi Builder",
  "description": "Deterministic static HTML component builder",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "bin": {
    "nabi": "./dist/cli.js",
    "nabi-language-server": "./dist/language-server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "----------": "----------",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "pack:check": "bun pm pack --dry-run --ignore-scripts",
    "-----------": "-----------",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run lint:check && bun run format:check && bun run test && bun run build && bun run pack:check",
    "------------": "------------",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "prepare": "bun run scripts/prepare.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "parse5": "^8.0.0",
    "terser": "^5.50.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.4.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "keywords": [
    "nabi",
    "html",
    "ssg",
    "static-site-generator",
    "components",
    "build-tool"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabilabshq/builder.git"
  },
  "bugs": {
    "url": "https://github.com/nabilabshq/builder/issues"
  },
  "homepage": "https://github.com/nabilabshq/builder#readme"
}
